DATABASE_URL=postgres://blr:blr@localhost:5433/blr_rentals
# Supabase: DATABASE_URL = transaction pooler (6543), DATABASE_URL_DIRECT = session pooler (5432).
# DATABASE_URL_DIRECT is used by migrate and seed only; leave unset for local Docker.
#DATABASE_URL_DIRECT=

# Integration tests run only when this is set, and never fall back to DATABASE_URL.
# Point it at a throwaway database (pnpm db:up), never at a database you care about.
#TEST_DATABASE_URL=postgres://blr:blr@localhost:5433/blr_rentals

SCRAPER_CONTACT=mailto:you@example.com
SCRAPER_USER_AGENT=blr-rentals/0.1 (+mailto:you@example.com) personal-use
SCRAPER_MIN_DELAY_MS=2500
SCRAPER_JITTER_MS=1000
SCRAPER_TIMEOUT_MS=30000
LOG_LEVEL=info
