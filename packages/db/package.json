{
  "name": "@blr/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "PostgreSQL/PostGIS schema (Drizzle), SQL migrations, seeds and the DB client shared by web and scraper.",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "migrate": "tsx src/migrate.ts",
    "seed": "tsx src/seed.ts",
    "studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@blr/core": "workspace:*",
    "dotenv": "^16.4.5",
    "drizzle-orm": "^0.44.0",
    "postgres": "^3.4.5"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "drizzle-kit": "^0.31.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  }
}
