{
  "name": "@blr/extension",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Chrome extension that overlays BLR Flat Hunt data on NoBroker and MagicBricks listing pages.",
  "scripts": {
    "build": "node build.mjs",
