{
  "name": "blr-rentals",
  "version": "0.1.0",
  "private": true,
  "description": "Unified Bangalore rental search: one interface over NoBroker and MagicBricks (MVP), with Housing.com and 99acres as later adapters.",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "pnpm --filter @blr/web dev",
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:migrate": "pnpm --filter @blr/db migrate",
    "db:seed": "pnpm --filter @blr/db seed",
    "scraper": "pnpm --filter @blr/scraper cli"
  },
  "devDependencies": {
    "typescript": "^5.6.0"
  },
  "packageManager": "pnpm@11.22.0"
}
